### 测试combineLatest

```swift
func testCombineLatest() {
    let expectation = XCTestExpectation(description: "combineLatest测试")
    let subject1 = PassthroughSubject<String, Never>()
    let subject2 = PassthroughSubject<Int, Never>()
    var receivedValues: [(String, Int)] = []
    
    subject1
        .combineLatest(subject2)
        .sink(
            receiveCompletion: { _ in
                expectation.fulfill()
            },
            receiveValue: { value in
                receivedValues.append(value)
            }
        )
        .store(in: &cancellables)
    
    // 发送值
    subject1.send("A")
    subject2.send(1) // 应该收到 ("A", 1)
    subject1.send("B") // 应该收到 ("B", 1)
    
    subject1.send(completion: .finished)
    
    wait(for: [expectation], timeout: 1.0)
    XCTAssertEqual(receivedValues.count, 2)
}
```

## 7.4 测试ViewModel

```swift
class ViewModelTests: XCTestCase {
    var viewModel: TestViewModel!
    var mockService: MockService!
    var cancellables = Set<AnyCancellable>()
    
    override func setUp() {
        super.setUp()
        mockService = MockService()
        viewModel = TestViewModel(service: mockService)
    }
    
    override func tearDown() {
        viewModel = nil
        mockService = nil
        cancellables.removeAll()
        super.tearDown()
    }
    
    func testDataLoading() {
        let expectation = XCTestExpectation(description: "数据加载")
        let expectedData = [Item(id: 1, name: "Test")]
        
        // 设置mock数据
        mockService.mockData = Just(expectedData)
            .setFailureType(to: Error.self)
            .eraseToAnyPublisher()
        
        // 观察viewModel变化
        viewModel.$data
            .dropFirst() // 跳过初始值
            .sink { data in
                XCTAssertEqual(data, expectedData)
                expectation.fulfill()
            }
            .store(in: &cancellables)
        
        viewModel.loadData()
        
        wait(for: [expectation], timeout: 1.0)
    }
    
    func testErrorHandling() {
        let expectation = XCTestExpectation(description: "错误处理")
        let testError = TestError.networkError
        
        mockService.mockData = Fail(error: testError)
            .eraseToAnyPublisher()
        
        viewModel.$errorMessage
            .dropFirst()
            .sink { errorMessage in
                XCTAssertNotNil(errorMessage)
                expectation.fulfill()
            }
            .store(in: &cancellables)
        
        viewModel.loadData()
        
        wait(for: [expectation], timeout: 1.0)
    }
}
```

## 7.5 测试工具类

### TestScheduler

```swift
import Combine

class TestScheduler<S: Scheduler>: Scheduler {
    typealias SchedulerTimeType = S.SchedulerTimeType
    typealias SchedulerOptions = S.SchedulerOptions
    
    private let wrapped: S
    private(set) var scheduledActions: [(date: SchedulerTimeType, action: () -> Void)] = []
    
    init(wrapping wrapped: S) {
        self.wrapped = wrapped
    }
    
    var now: SchedulerTimeType { wrapped.now }
    var minimumTolerance: S.SchedulerTimeType.Stride { wrapped.minimumTolerance }
    
    func schedule(
        after date: SchedulerTimeType,
        tolerance: S.SchedulerTimeType.Stride,
        options: S.SchedulerOptions?,
        _ action: @escaping () -> Void
    ) {
        scheduledActions.append((date, action))
    }
    
    func schedule(
        options: S.SchedulerOptions?,
        _ action: @escaping () -> Void
    ) {
        schedule(after: now, tolerance: minimumTolerance, options: options, action)
    }
    
    func schedule(
        after date: SchedulerTimeType,
        interval: S.SchedulerTimeType.Stride,
        tolerance: S.SchedulerTimeType.Stride,
        options: S.SchedulerOptions?,
        _ action: @escaping () -> Void
    ) -> Cancellable {
        // 实现重复调度
        return AnyCancellable {}
    }
    
    func fastForward(to date: SchedulerTimeType) {
        let actionsToRun = scheduledActions.filter { $0.date <= date }
        for action in actionsToRun {
            action.action()
        }
        scheduledActions.removeAll { $0.date <= date }
    }
}
```

## 7.6 常见调试问题

### 问题1：订阅不触发

**可能原因**：没有持有AnyCancellable
**解决**：使用.store(in:)

```swift
// ❌ 错误：订阅立即取消
publisher.sink { value in
    print(value)
}

// ✅ 正确：持有订阅
publisher.sink { value in
    print(value)
}.store(in: &cancellables)
```

### 问题2：重复订阅

**可能原因**：在View的body中订阅
**解决**：在onAppear中或ViewModel中订阅

### 问题3：值不更新

**可能原因**：线程问题
**解决**：检查receive(on:)

## 7.7 最佳实践

1. **使用print()快速调试**：简单有效
2. **使用handleEvents深入调试**：观察所有事件
3. **编写单元测试**：保证代码质量
4. **使用XCTestExpectation**：测试异步代码
5. **Mock依赖**：隔离测试

