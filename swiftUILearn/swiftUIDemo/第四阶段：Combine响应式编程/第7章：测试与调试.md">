## 7.1 调试技巧

### print()操作符

print()是最简便的调试工具：

```swift
publisher
    .print("调试标签")
    .sink { value in
        print("处理值: \(value)")
    }
    .store(in: &cancellables)
```

输出示例：
```
调试标签: receive subscription: (PassthroughSubject)
调试标签: request unlimited
调试标签: receive value: (Hello)
调试标签: receive finished
```

### handleEvents操作符

handleEvents可以观察所有事件而不影响数据：

```swift
publisher
    .handleEvents(
        receiveSubscription: { subscription in
            print("收到订阅: \(subscription)")
        },
        receiveOutput: { value in
            print("收到值: \(value)")
        },
        receiveCompletion: { completion in
            print("完成: \(completion)")
        },
        receiveCancel: {
            print("订阅被取消")
        },
        receiveRequest: { demand in
            print("请求: \(demand)")
        }
    )
    .sink { value in
        print("最终处理: \(value)")
    }
    .store(in: &cancellables)
```

### breakpoint操作符

在调试时暂停执行：

```swift
publisher
    .breakpoint(
        receiveSubscription: { _ in false },
        receiveOutput: { value in
            // 当值满足条件时暂停
            return value < 0
        },
        receiveCompletion: { _ in false }
    )
    .sink { value in
        print(value)
    }
    .store(in: &cancellables)
```

### breakpointOnError

```swift
publisher
    .breakpointOnError()
    .sink(
        receiveCompletion: { completion in
            print(completion)
        },
        receiveValue: { value in
            print(value)
        }
    )
    .store(in: &cancellables)
```

## 7.2 测试Combine代码

### 测试简单发布者

```swift
import XCTest
import Combine

class CombineTests: XCTestCase {
    private var cancellables = Set<AnyCancellable>()
    
    func testJustPublisher() {
        let expectation = XCTestExpectation(description: "Just发布者")
        let expectedValue = "Hello"
        
        Just(expectedValue)
            .sink { value in
                XCTAssertEqual(value, expectedValue)
                expectation.fulfill()
            }
            .store(in: &cancellables)
        
        wait(for: [expectation], timeout: 1.0)
    }
}
```

### 测试错误

```swift
func testErrorPublisher() {
    let expectation = XCTestExpectation(description: "错误测试")
    let testError = TestError.somethingWentWrong
    
    Fail<String, TestError>(error: testError)
        .sink(
            receiveCompletion: { completion in
                if case .failure(let error) = completion {
                    XCTAssertEqual(error, testError)
                    expectation.fulfill()
                }
            },
            receiveValue: { _ in
                XCTFail("不应该收到值")
            }
        )
        .store(in: &cancellables)
    
    wait(for: [expectation], timeout: 1.0)
}
```

### 使用XCTestExpectation测试异步代码

```swift
func testAsyncPublisher() {
    let expectation = XCTestExpectation(description: "异步测试")
    let expectedValue = "Result"
    
    // 模拟异步操作
    let publisher = Future<String, Never> { promise in
        DispatchQueue.global().asyncAfter(deadline: .now() + 0.1) {
            promise(.success(expectedValue))
        }
    }
    
    publisher
        .sink { value in
            XCTAssertEqual(value, expectedValue)
            expectation.fulfill()
        }
        .store(in: &cancellables)
    
    wait(for: [expectation], timeout: 1.0)
}
```

### 测试多个值

```swift
func testSequencePublisher() {
    let expectation = XCTestExpectation(description: "序列测试")
    let expectedValues = [1, 2, 3]
    var receivedValues: [Int] = []
    
    [1, 2, 3].publisher
        .sink(
            receiveCompletion: { completion in
                if case .finished = completion {
                    XCTAssertEqual(receivedValues, expectedValues)
                    expectation.fulfill()
                }
            },
            receiveValue: { value in
                receivedValues.append(value)
            }
        )
        .store(in: &cancellables)
    
    wait(for: [expectation], timeout: 1.0)
}
```

